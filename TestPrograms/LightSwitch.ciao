ciao LightSwitchInteraction
    class Person
        events
            pressSwitch
        effects
            sendTurnOn
            sendTurnOff
        conditions
            isLightOff
        variables
            lightState : Boolean
        states
            Idle -> pressSwitch [isLightOff] / sendTurnOn -> Idle
                [else] / sendTurnOff -> end
    class Light
        events
            turnOn
            turnOff
        states
            Off -> turnOn -> On
            On -> turnOff -> Off
    scheme
        objects
            human = new Person (Idle)
            bulb = new Light (Off)
        links
            human.sendTurnOn <- bulb.turnOn
            human.sendTurnOff <- bulb.turnOff
        public
            human.pressSwitch
.