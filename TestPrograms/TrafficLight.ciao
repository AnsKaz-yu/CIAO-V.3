ciao TrafficLightProg
    class TrafficLight
        events
            switch
            onGreen
            onRed
            stop
        effects
            to_green
            to_red
        variables
            t1: Integer
            t2: Integer
        states
            Idle -> switch / t1:=20; t2:=10-> Red
            Red -> after (t1) / to_green-> Red
            Red -> onGreen -> Green
            Red -> stop -> Idle
            Green -> after (t2) / to_red-> Green
            Green -> onRed -> Red
            Green -> stop -> Idle
    scheme
        objects
            traffic_light = new TrafficLight (Idle)
        links
            traffic_light.to_green <- traffic_light.onGreen
            traffic_light.to_red <- traffic_light.onRed
        public
            traffic_light.switch
            traffic_light.stop
.