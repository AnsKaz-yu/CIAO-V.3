ciao TrafficLightProg
    class TrafficLight
        events
            switch_1
            switch_2
        effects
            red_on
            green_on
        states
            Idle -> switch_1 / red_on -> Red
            Red -> switch_2 / green_on -> Green
            Green -> switch_1 / red_on -> Red
    scheme
        objects
            traffic_light = new TrafficLight (Idle)
        links
            traffic_light.switch_1 <- traffic_light.switch_2
.